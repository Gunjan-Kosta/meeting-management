{
  "name": "meeting-management-server",
  "version": "1.0.0",
  "description": "Enterprise Meeting Management System Backend",
  "main": "app.js",
  "type": "module",
  "scripts": {
    "start": "node app.js",
    "dev": "node --watch app.js",
