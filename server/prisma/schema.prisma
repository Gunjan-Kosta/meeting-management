datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  STATE_ADMIN
  DISTRICT_USER
  VIEWER
}

enum MeetingType {
  DISTRICT_LEVEL
  SANSAD
  RAJYA_SADAK_SURAKSHA
  SAMIKSHA_BAITHAK
  MANTRI_PARISHAD
}

enum MeetingStatus {
  DRAFT
  SUBMITTED
  CLOSED
}

enum ActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum DocumentType {
  MOM
  ATTENDANCE_SHEET
  AGENDA
  PROCEEDINGS
  SUPPORTING
}

model User {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  email        String        @unique
  passwordHash String
  firstName    String
  lastName     String
  role         Role          @default(VIEWER)
  departmentId String?       @db.ObjectId
  department   Department?   @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  district     String?
  profileImage String?
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  auditLogs    AuditLog[]
  actionItems  MeetingActionTracker[]
  meetings     Meeting[]     @relation("MeetingCreator")
  documents    MeetingDocument[]

  @@index([role])
}

model Department {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  name        String                 @unique
  code        String                 @unique
  description String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  users       User[]
  actionItems MeetingActionTracker[]
}

model Meeting {
  id          String                 @id @default(auto()) @map("_id") @db.ObjectId
  meetingCode String                 @unique
  title       String
  description String
  meetingType MeetingType
  meetingDate DateTime
  venue       String
  district    String
  status      MeetingStatus          @default(DRAFT)
  creatorId   String                 @db.ObjectId
  creator     User                   @relation("MeetingCreator", fields: [creatorId], references: [id])
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  documents    MeetingDocument[]
  participants MeetingParticipant[]
  actionItems  MeetingActionTracker[]

  @@index([meetingType])
  @@index([status])
  @@index([district])
}

model MeetingDocument {
  id           String       @id @default(auto()) @map("_id") @db.ObjectId
  meetingId    String       @db.ObjectId
  meeting      Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name         String
  filePath     String
  fileType     DocumentType
  fileSize     Int
  mimeType     String?
  fileData     Bytes?
  uploadedById String       @db.ObjectId
  uploadedBy   User         @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([meetingId])
}

model MeetingParticipant {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  meetingId   String   @db.ObjectId
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  name        String
  designation String
  department  String
  email       String?
  phone       String?
  isPresent   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([meetingId])
}

model MeetingActionTracker {
  id                   String       @id @default(auto()) @map("_id") @db.ObjectId
  meetingId            String       @db.ObjectId
  meeting              Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title                String
  description          String
  assignedDepartmentId String       @db.ObjectId
  assignedDepartment   Department   @relation(fields: [assignedDepartmentId], references: [id])
  assignedUserId       String?      @db.ObjectId
  assignedUser         User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  targetDate           DateTime
  remarks              String?
  status               ActionStatus @default(PENDING)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@index([meetingId])
  @@index([assignedDepartmentId])
  @@index([status])
}

model AuditLog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  meetingId String?  @db.ObjectId
  action    String
  details   String
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
  @@index([action])
  @@index([meetingId])
  @@index([action, createdAt])
}
